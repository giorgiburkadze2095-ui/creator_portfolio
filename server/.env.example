# Copy to .env and adjust for your environment.

PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# SQLite file, relative to the server package root.
DATABASE_PATH=data/db.sqlite

# Change this in every real deployment.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Used once, on first boot, to create the initial SUPER_ADMIN if none exists.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
SUPER_ADMIN_NAME=Site Owner
